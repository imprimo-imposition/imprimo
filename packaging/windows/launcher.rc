#include <winver.h>
1 ICON "imprimo.ico"
1 VERSIONINFO
FILEVERSION 0,7,1,0
PRODUCTVERSION 0,7,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Maxim Darak"
      VALUE "FileDescription", "Imprimo"
      VALUE "FileVersion", "0.7.1"
      VALUE "InternalName", "Imprimo"
      VALUE "OriginalFilename", "Imprimo.exe"
      VALUE "ProductName", "Imprimo"
      VALUE "ProductVersion", "0.7.1"
      VALUE "LegalCopyright", "(C) Maxim Darak, GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
